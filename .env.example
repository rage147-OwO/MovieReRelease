# KOBIS(영화진흥위원회) 오픈API 키 — https://www.kobis.or.kr/kobisopenapi 에서 무료 발급
# 없어도 동작하지만, 재개봉작의 원개봉일 표시가 빠짐
KOBIS_API_KEY=

# 카카오 REST API 키 (선택, 포스터 보조 검색용 — 현재 미사용)
KAKAO_API_KEY=

# 신규 재개봉작 감지 시 알림을 보낼 Discord 웹훅 URL (선택)
# 디스코드 서버 설정 → 연동 → 웹후크 → 새 웹후크 → 채널 선택 → URL 복사
# 없어도 동작하지만, 알림 전송이 조용히 건너뛰어진다
DISCORD_WEBHOOK_URL=
